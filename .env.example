# このファイルを .env にコピーして使うか、シェルで export してください。
# .env は .gitignore 済みです。

# --- 任意: FRED の無料 API キー（発表日が公式の確定値になる）------------
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- 任意: Slack / Discord の Webhook URL（週次ダイジェスト送信用）------
ECON_CAL_WEBHOOK_URL=

# --- CI / サーバ実行用の Google 認証 -----------------------------------
# ローカルで `python -m econ_cal auth` を実行して作った token.json の
# 中身をそのまま1行で入れる（GitHub Actions では Secrets に登録する）
GOOGLE_TOKEN_JSON=

# 上の代わりに個別指定でも可
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# サービスアカウントを使う場合（カレンダーを共有設定にしておくこと）
# GOOGLE_SERVICE_ACCOUNT_JSON=
